+/// Probe only, never committed: a hue carried with the light, each newly
+/// reached voxel taking the mean hue of the voxels that reached it in the
+/// step that reached it.
+pub(crate) struct Hues<R> {
+    /// Each voxel's hue, at `z + (x + y × side) × side`: 8-bit red, green and
+    /// blue from bit 0 up. Only the voxels `has` holds have one.
+    rgb: Vec<u32>,
+    /// The voxels holding a hue.
+    has: Vec<R>,
+    /// Each seed's hue, in the seeds' order.
+    seeds: Vec<u32>,
+    /// The hue of the chunk's voxels after a run, at `z + (x + y × 32) × 32`,
+    /// 0 where light doesn't reach.
+    out: Vec<u32>,
+}
+
+/// Probe only: the three bytes of `rgb`, each in a 16-bit lane.
+#[inline(always)]
+fn lanes(rgb: u32) -> u64 {
+    let rgb = rgb as u64;
+    (rgb & 0xff) | (rgb & 0xff00) << 8 | (rgb & 0xff_0000) << 16
+}
+
+/// Probe only: 65536 / n rounded up, for a mean of n hues.
+const RECIPROCALS: [u32; 7] = [0, 65536, 32768, 21846, 16384, 13108, 10923];
+
+/// Probe only: gives each voxel `new` holds and `old` doesn't the mean hue of
+/// its neighbours in `from` that `old` holds, over rows `xs` along x and `ys`
+/// along y. `old` of `None` reads `has`, for a step within a row.
+#[allow(clippy::too_many_arguments)]
+fn blend<R: Row>(
+    hues: &mut Hues<R>,
+    old: Option<&[R]>,
+    new: &[R],
+    side: usize,
+    xs: std::ops::Range<usize>,
+    ys: std::ops::Range<usize>,
+    from: &[Step],
+) {
+    let mut sources = [[0u64; 2]; 6];
+    let mut offsets = [0isize; 6];
+    for y in ys {
+        for x in xs.clone() {
+            let i = x + y * side;
+            let at = |j: usize, has: &[R]| match old {
+                Some(old) => old[j],
+                None => has[j],
+            };
+            let before = at(i, &hues.has);
+            let fresh = new[i] & !before;
+            if fresh == R::ZERO {
+                continue;
+            }
+            for (k, &step) in from.iter().enumerate() {
+                let (rows, offset) = match step {
+                    Step::ZBelow => (before << 1, -1),
+                    Step::ZAbove => (before >> 1, 1),
+                    Step::Row(o) => (at((i as isize + o) as usize, &hues.has), o * side as isize),
+                };
+                sources[k] = rows.words();
+                offsets[k] = offset;
+            }
+            let base = i * side;
+            for (w, mut bits) in fresh.words().into_iter().enumerate() {
+                while bits != 0 {
+                    let bit = bits.trailing_zeros() as usize;
+                    bits &= bits - 1;
+                    let voxel = base + w * 64 + bit;
+                    let mut sum = 0u64;
+                    let mut n = 0;
+                    for k in 0..from.len() {
+                        if sources[k][w] >> bit & 1 == 1 {
+                            sum += lanes(hues.rgb[(voxel as isize + offsets[k]) as usize]);
+                            n += 1;
+                        }
+                    }
+                    debug_assert!(n > 0);
+                    let r = RECIPROCALS[n];
+                    let mean = |shift: u32| (((sum >> shift) as u32 & 0xffff) * r + 32768) >> 16;
+                    hues.rgb[voxel] = mean(0) | mean(16) << 8 | mean(32) << 16;
+                }
+            }
+            hues.has[i] |= fresh;
+        }
+    }
+}
+
+/// Probe only, never committed: a colour index carried with the light, each
+/// newly reached voxel taking the index of a voxel that reached it.
+pub(crate) struct Labels<R> {
+    /// A box of rows per bit of the index.
+    rows: Vec<Vec<R>>,
+    /// The voxels holding an index.
+    has: Vec<R>,
+    /// Each seed's index, in the seeds' order.
+    seeds: Vec<u8>,
+    /// The index of the chunk's voxels after a run, a plane per bit.
+    out: Vec<Plane>,
+}
+
+/// Probe only: where a voxel's light came from in a step.
+#[derive(Clone, Copy)]
+enum Step {
+    /// The voxel at z - 1 in the same row.
+    ZBelow,
+    /// The voxel at z + 1 in the same row.
+    ZAbove,
+    /// The voxel at the same z in the row this far away.
+    Row(isize),
+}
+
+/// Probe only: gives each voxel `new` holds and `old` doesn't the index of the
+/// first neighbour in `from` that `old` holds, over rows `xs` along x and `ys`
+/// along y. `old` of `None` reads `has`, for a step within a row.
+#[allow(clippy::too_many_arguments)]
+fn carry<R: Row>(
+    labels: &mut Labels<R>,
+    old: Option<&[R]>,
+    new: &[R],
+    side: usize,
+    xs: std::ops::Range<usize>,
+    ys: std::ops::Range<usize>,
+    from: &[Step],
+) {
+    for y in ys {
+        for x in xs.clone() {
+            let i = x + y * side;
+            let at = |j: usize, has: &[R]| match old {
+                Some(old) => old[j],
+                None => has[j],
+            };
+            let before = at(i, &labels.has);
+            let fresh = new[i] & !before;
+            if fresh == R::ZERO {
+                continue;
+            }
+            let mut left = fresh;
+            for &step in from {
+                let source = match step {
+                    Step::ZBelow => before << 1,
+                    Step::ZAbove => before >> 1,
+                    Step::Row(offset) => at((i as isize + offset) as usize, &labels.has),
+                };
+                let take = left & source;
+                if take == R::ZERO {
+                    continue;
+                }
+                left &= !take;
+                for rows in labels.rows.iter_mut() {
+                    let index = match step {
+                        Step::ZBelow => rows[i] << 1,
+                        Step::ZAbove => rows[i] >> 1,
+                        Step::Row(offset) => rows[(i as isize + offset) as usize],
+                    };
+                    rows[i] |= take & index;
+                }
+                if left == R::ZERO {
+                    break;
+                }
+            }
+            labels.has[i] |= fresh;
+        }
+    }
 }
 
