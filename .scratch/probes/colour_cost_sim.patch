+/// Probe only, never committed: what coloured voxel light would cost a solve,
+/// with light kept white and exact. `COLOUR_SIM=groups<K>` spreads a run per
+/// light colour, lamps taking one of K colours by a hash of where they are
+/// in the box, mixes runs where two or more reach the chunk into three 8-bit
+/// components and packs them as 4-byte texels; the white light is the max
+/// over the runs. `COLOUR_SIM=components` spreads a run per component of
+/// orange lamps (levels 15, 13 and 10), packs the three as texels of 2 bytes
+/// at 16 levels and 4 at 256; the white light is the red run.
+pub(crate) mod colour_sim {
+    use std::sync::OnceLock;
+
+    use super::*;
+    use crate::light::faces::mix;
+
+    #[derive(Clone, Copy, PartialEq, Debug)]
+    pub(crate) enum Sim {
+        Off,
+        Groups(usize),
+        Components,
+    }
+
+    pub(crate) fn sim() -> Sim {
+        static SIM: OnceLock<Sim> = OnceLock::new();
+        *SIM.get_or_init(|| {
+            let sim = match std::env::var("COLOUR_SIM").as_deref() {
+                Ok("components") => Sim::Components,
+                Ok(groups) if groups.starts_with("groups") => {
+                    Sim::Groups(groups[6..].parse().expect("groups<K>"))
+                }
+                _ => Sim::Off,
+            };
+            if sim != Sim::Off {
+                eprintln!("colour cost simulation: {sim:?}");
+            }
+            sim
+        })
+    }
+
+    fn lit(planes: &[Plane]) -> bool {
+        planes.iter().any(|plane| plane.iter().any(|&column| column != 0))
+    }
+
+    const SPREAD: [u64; 256] = {
+        let mut table = [0u64; 256];
+        let mut byte = 0;
+        while byte < 256 {
+            let mut bit = 0;
+            while bit < 8 {
+                if byte >> bit & 1 == 1 {
+                    table[byte] |= 1 << (bit * 8);
+                }
+                bit += 1;
+            }
+            byte += 1;
+        }
+        table
+    };
+
+    fn group_levels(planes: &[Plane], column: usize, shift: usize) -> u64 {
+        let mut texels = 0;
+        for (bit, plane) in planes.iter().enumerate() {
+            texels |= SPREAD[(plane[column] >> shift) as usize & 0xFF] << bit;
+        }
+        texels
+    }
+
+    fn every_other_byte(bytes: u64) -> u128 {
+        let mut wide = bytes as u128;
+        wide = (wide | wide << 32) & 0x0000_0000_FFFF_FFFF_0000_0000_FFFF_FFFF;
+        wide = (wide | wide << 16) & 0x0000_FFFF_0000_FFFF_0000_FFFF_0000_FFFF;
+        (wide | wide << 8) & 0x00FF_00FF_00FF_00FF_00FF_00FF_00FF_00FF
+    }
+
+    fn every_fourth_byte(bytes: u32) -> u128 {
+        let mut wide = bytes as u128;
+        wide = (wide | wide << 48) & 0x0000_0000_0000_FFFF_0000_0000_0000_FFFF;
+        (wide | wide << 24) & 0x0000_00FF_0000_00FF_0000_00FF_0000_00FF
+    }
+
+    fn put_four(bytes: &mut [u8], lanes: [u64; 4]) {
+        for half in 0..2 {
+            let mut texels = 0u128;
+            for (i, lane) in lanes.iter().enumerate() {
+                texels |= every_fourth_byte((lane >> (32 * half)) as u32) << (8 * i);
+            }
+            bytes[16 * half..16 * half + 16].copy_from_slice(&texels.to_le_bytes());
+        }
+    }
+
+    /// A slot of sky light and three components, as a slot of `wide`-byte
+    /// texels holds them, from each component's levels: `lane(c, column,
+    /// shift)` gives 8 voxels' levels a byte each. Discarded.
+    fn pack(wide: usize, occupancy: &Occupancy, lane: impl Fn(usize, usize, usize) -> u64) -> Box<[u8]> {
+        let mut bytes = vec![0u8; 34 * 34 * 34 * wide].into_boxed_slice();
+        for y in 0..32 {
+            for x in 0..32 {
+                let column = x + y * 32;
+                let open = !occupancy.solid_column(x, y);
+                let row = 1 + (x + 1) * 34 + (y + 1) * 34 * 34;
+                for shift in (0..32).step_by(8) {
+                    let open_byte = (open >> shift) as usize & 0xFF;
+                    let mask = SPREAD[open_byte] * 0xFF;
+                    let sky = SPREAD[open_byte] * 15;
+                    let at = (row + shift) * wide;
+                    let [r, g, b] = [0, 1, 2].map(|c| lane(c, column, shift) & mask);
+                    if wide == 2 {
+                        bytes[at..at + 16].copy_from_slice(
+                            &(every_other_byte(sky | r << 4) | every_other_byte(g | b << 4) << 8)
+                                .to_le_bytes(),
+                        );
+                    } else {
+                        put_four(&mut bytes[at..at + 32], [sky, r, g, b]);
+                    }
+                }
+            }
+        }
+        bytes
+    }
+
+    pub(crate) fn solve(
+        neighbours: &Neighbourhood,
+        scale: &LevelScale,
+        shape: LightShape,
+        seeds: &[Seed],
+        occupancy: &Occupancy,
+    ) -> (ChannelLight, [u64; 6]) {
+        let precision = scale.precision();
+        let bits = precision.bits();
+        let runs: Vec<Vec<Seed>> = match sim() {
+            Sim::Groups(k) => {
+                let mut parts = vec![Vec::new(); k];
+                for seed in seeds {
+                    let hash = (seed.x as u32).wrapping_mul(73_856_093)
+                        ^ (seed.y as u32).wrapping_mul(19_349_663)
+                        ^ (seed.z as u32).wrapping_mul(83_492_791);
+                    parts[(hash >> 7) as usize % k].push(*seed);
+                }
+                parts.retain(|part| !part.is_empty());
+                parts
+            }
+            Sim::Components => {
+                let top = scale.start(precision.of_whole(15)).unwrap_or(0);
+                [15u8, 13, 10]
+                    .iter()
+                    .map(|&level| {
+                        let extra = scale
+                            .start(precision.of_whole(level))
+                            .map_or(u8::MAX, |start| start - top);
+                        let mut run: Vec<Seed> = seeds
+                            .iter()
+                            .filter(|seed| (seed.start as u32 + extra as u32) < scale.reach())
+                            .map(|seed| Seed {
+                                start: seed.start + extra,
+                                ..*seed
+                            })
+                            .collect();
+                        run.sort_by_key(|seed| seed.start);
+                        run
+                    })
+                    .collect()
+            }
+            Sim::Off => unreachable!(),
+        };
+        let mut faces = [0u64; 6];
+        let mut reaching: Vec<Box<[Plane]>> = Vec::new();
+        for run in &runs {
+            if run.is_empty() {
+                reaching.push(empty_planes(precision));
+                continue;
+            }
+            let (planes, run_faces) = spread(neighbours, scale, shape, run, None, None);
+            for (face, run_face) in faces.iter_mut().zip(run_faces) {
+                *face = mix(*face, run_face);
+            }
+            if lit(&planes) || sim() == Sim::Components {
+                reaching.push(planes);
+            }
+        }
+        if reaching.is_empty() {
+            return (ChannelLight::Uniform(0), faces);
+        }
+        let white = match sim() {
+            Sim::Components => {
+                if reaching.iter().any(|planes| lit(planes)) {
+                    let wide = if bits == 4 { 2 } else { 4 };
+                    std::hint::black_box(pack(wide, occupancy, |c, column, shift| {
+                        group_levels(&reaching[c], column, shift)
+                    }));
+                }
+                reaching.swap_remove(0)
+            }
+            _ if reaching.len() == 1 => reaching.pop().unwrap(),
+            _ => {
+                // Each component the max over runs of a table at the run's
+                // level: red keeps the level, so it's the white light.
+                let mut out: [Vec<u8>; 3] = std::array::from_fn(|_| vec![0u8; 32768]);
+                let drop = [0u8, 2 * (bits as u8 - 3), 5 * (bits as u8 - 3)];
+                for (run, planes) in reaching.iter().enumerate() {
+                    for column in 0..1024 {
+                        let any = planes.iter().fold(0, |any, plane| any | plane[column]);
+                        if any == 0 {
+                            continue;
+                        }
+                        for shift in (0..32).step_by(8) {
+                            if (any >> shift) & 0xFF == 0 {
+                                continue;
+                            }
+                            let levels = group_levels(planes, column, shift).to_le_bytes();
+                            for (i, &level) in levels.iter().enumerate() {
+                                if level == 0 {
+                                    continue;
+                                }
+                                for c in 0..3 {
+                                    let value = level.saturating_sub(drop[(c + run) % 3] * (c != 0) as u8);
+                                    let cell = &mut out[c][column * 32 + shift + i];
+                                    *cell = (*cell).max(value);
+                                }
+                            }
+                        }
+                    }
+                }
+                let mut planes = empty_planes(precision);
+                for column in 0..1024 {
+                    for z in 0..32 {
+                        let level = out[0][column * 32 + z];
+                        for (bit, plane) in planes.iter_mut().enumerate() {
+                            plane[column] |= ((level >> bit & 1) as u32) << z;
+                        }
+                    }
+                }
+                std::hint::black_box(pack(4, occupancy, |c, column, shift| {
+                    let base = column * 32 + shift;
+                    u64::from_le_bytes(out[c][base..base + 8].try_into().unwrap())
+                }));
+                planes
+            }
+        };
+        (channel_light(white, occupancy), faces)
+    }
+}
