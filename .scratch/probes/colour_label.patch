+                    Seed {
+                        x: position.x as u8,
+                        y: position.y as u8,
+                        z: position.z as u8,
+                        start: scale.start(level)?,
+                    },
+                    index,
+                ))
+            })
+            .collect();
+        seeds.sort_by_key(|(seed, _)| seed.start);
